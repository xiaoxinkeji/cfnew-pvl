# 抓取器的全量清单缓存（33 MB），不要提交
tools/.cache/

# 抓取产物：节点会过期，按需本地重跑
pvl/nodes/
pvl/sub/

# Python
__pycache__/
*.pyc

# Node
node_modules/

# 3x-ui 同步器：面板地址 + API token，绝不能提交
tools/config.json
cmd/homesync/config.json
cmd/homesync/.sync_state.json
tools/.sync_state.json

# Go 构建产物
# 只忽略仓库根的可执行文件：裸写 homesync 会把 cmd/homesync/ 源码目录一起吞掉
dist/
/homesync
/homesync.exe

# 面板地址缓存（不含 token，但含面板子路径）
cmd/homesync/.xui-url
